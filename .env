DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_DEBUG=1

# Postgres
POSTGRES_DB=notif
POSTGRES_USER=notif
POSTGRES_PASSWORD=notif
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# SMTP (Mailhog in docker-compose)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=no-reply@example.com

# Telegram (use a real bot token if you want to test)
TELEGRAM_BOT_TOKEN=fake-telegram-token

# Twilio-like SMS (this demo uses a stub, but keep vars for real world)
TWILIO_SID=sid
TWILIO_TOKEN=token
TWILIO_FROM=+10000000000
